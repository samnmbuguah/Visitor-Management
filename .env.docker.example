# Domain configuration
# Set this to your server's IP for sslip.io, e.g. 213-199-50-129.sslip.io
# Caddy will auto-provision SSL certificates for all subdomains.
DOMAIN=213-199-50-129.sslip.io

# Seed data password for demo/test users
SEED_USER_PASSWORD=changeme123!

# --- Optional: Email settings (for notifications) ---
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com


    import headers_common
    header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://pmapi.*; frame-ancestors 'none'; base-uri 'self'"
    reverse_proxy mobile_admin:8084
}


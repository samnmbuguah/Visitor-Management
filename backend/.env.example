# Django
DEBUG=False
SECRET_KEY=change-this-to-a-long-random-string
ALLOWED_HOSTS=.your-domain.com,localhost
DOMAIN=your-domain.com

# Database (SQLite default, uncomment for PostgreSQL)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@your-domain.com

# Sentry Error Tracking (optional)
SENTRY_DSN=https://your-dsn@sentry.io/your-project
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Stripe Payment (optional)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# FCM Push Notifications (optional)
FCM_SERVER_KEY=your-fcm-server-key

# Seed Data
SEED_USER_PASSWORD=changeme123!
